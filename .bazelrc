# Bazel configuration for bfadmin project

# Use Java 21
build --java_language_version=21
build --java_runtime_version=21
build --tool_java_language_version=21
build --tool_java_runtime_version=21

# Test configuration
test --test_output=errors
test --test_summary=detailed

# Build optimization
build --strategy=Javac=worker

# Disable bzlmod to use WORKSPACE
common --noenable_bzlmod

# Disable any remote/LFS functionality
build --noremote_accept_cached
build --noremote_upload_local_results

# Use local execution only
build --spawn_strategy=local
build --genrule_strategy=local

# Network configuration for SSL issues
build --repository_disable_download=false
fetch --repository_disable_download=false